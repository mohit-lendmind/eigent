"""Eigent desktop build authority.

The Node and pnpm versions are immutable inputs, not ambient developer tools.
The package graph comes exclusively from the committed pnpm lockfile.
"""

module(
    name = "eigent",
    version = "1.0.2",
)

# 2.9.2 is the newest verified line compatible with the shared Bazel 7.4.1
# toolchain used by the Aion cross-repository integration build.
bazel_dep(name = "aspect_rules_js", version = "2.9.2")
# Already in the resolved graph via aspect_rules_js; declared directly for
# copy_to_bin (shared bin copies of the e2e sources — see BUILD.bazel).
bazel_dep(name = "aspect_bazel_lib", version = "2.19.2")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.0")
use_repo(node, "nodejs_toolchains")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    data = [
        "//:package.json",
        "//package/@stackframe/react:package.json",
        "//:pnpm-workspace.yaml",
    ],
    name = "npm",
    # These native packages insist on a HOME for cache discovery. Give their
    # install actions a deterministic action-local value without inheriting
    # the developer machine's shell environment.
    lifecycle_hooks_envs = {
        "koffi": ["HOME=."],
        "node-pty": ["HOME=."],
    },
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")
